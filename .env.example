# ──────────────────────────────────────────────────────────────────────────────
# Penny — LLM provider configuration
# ──────────────────────────────────────────────────────────────────────────────
#
# Penny supports two providers. In order of preference:
#
# 1) Vercel AI Gateway (REQUIRED for P0.5 features: catalog-pick, generator,
#    scorer, regenerate-section). Single key, multi-model routing, failover,
#    built-in telemetry.
#
#    Get a key: https://vercel.com/ai-gateway (free tier available)
#    On Vercel deployments this is auto-provisioned via OIDC — no key needed.
#
# 2) Poe (legacy fallback). Only used when AI_GATEWAY_API_KEY is missing.
#    Eventually deprecated.
#
# Set at least one. If both are set, the gateway wins.

# ── Preferred: Vercel AI Gateway ──
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key_here

# Optional per-task model overrides. Defaults are picked in src/lib/llm/router.ts.
# Format: provider/model-id  (e.g. anthropic/claude-sonnet-4.5, openai/gpt-4.1-mini)
# PENNY_MODEL_CHAT=anthropic/claude-sonnet-4.5
# PENNY_MODEL_PICKER=openai/gpt-4.1-mini
# PENNY_MODEL_GENERATOR=anthropic/claude-sonnet-4.5
# PENNY_MODEL_SCORER=openai/gpt-4.1-mini
# PENNY_MODEL_PATCHER=openai/gpt-4.1-mini
# PENNY_MODEL_ACCOMMODATION=anthropic/claude-sonnet-4.5

# ── Legacy fallback: Poe ──
# Only used by /api/chat when AI_GATEWAY_API_KEY is unset. Not supported by the
# new picker / generator / scorer endpoints.
# Get your key: https://poe.com/api_key
POE_API_KEY=your_poe_api_key_here
POE_BOT_NAME=Penny_Pedagogy_v1.0
